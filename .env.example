# Scenova local environment. Copy to .env.local and fill in real values.
# Never commit .env.local or any real credential.

# PostgreSQL connection string (Neon direct or pooled endpoint).
# Required for all server-side database access. Never use a browser-exposed key.
DATABASE_URL=

# Application base URL reserved for server-side redirects and links.
# Do not expose this value to the browser.
APP_URL=http://localhost:3000
